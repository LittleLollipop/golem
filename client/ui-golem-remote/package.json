{
  "name": "golem-client-remote",
  "version": "0.1.0",
  "description": "Golem remote 通道挂载桥：独立客户端包，仅负责把 golem 的 Remote 贡献 $mount 进 dsh 浏览器 runtime，建立 `ctx.remote.golem` 命名空间，供消费包（golem-client-ui-config）inject 后使用。对齐 dsh 基座 `dsh-api-remotes` 的『独立 mount』模式。",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-typert-protocol"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "build": "tsdown"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/**/*.d.ts"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-api-remotes": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-runtime": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.1-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-api-remotes": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-runtime": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.1-rc.2",
    "tsdown": "^0.13.0",
    "typescript": "^5.5.0",
    "zod": "^4.4.3"
  }
}
